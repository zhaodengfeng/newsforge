{
  "manifest_version": 3,
  "name": "NewsForge - News Reader & Translator",
  "version": "26.3.31",
  "description": "Clean reading mode, AI translation, and screenshot/PDF sharing for news sites. Supports Bloomberg, WSJ, NYTimes, FT, and The Economist.",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "https://*.bloomberg.com/*",
    "https://*.wsj.com/*",
    "https://*.nytimes.com/*",
    "https://*.nyt.com/*",
    "https://*.ft.com/*",
    "https://*.economist.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.bloomberg.com/*",
        "https://*.wsj.com/*",
        "https://*.nytimes.com/*",
        "https://*.nyt.com/*",
        "https://*.ft.com/*",
        "https://*.economist.com/*"
      ],
      "css": [
        "styles/content.css",
        "styles/reader.css"
      ],
      "js": [
        "adapters/base.js",
        "adapters/bloomberg.js",
        "adapters/wsj.js",
        "adapters/nytimes.js",
        "adapters/ft.js",
        "adapters/economist.js",
        "reader/renderer.js",
        "reader/translator.js",
        "lib/translator.js",
        "lib/dom-parser.js",
        "lib/html2canvas.min.js",
        "lib/jspdf.umd.min.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "styles/*",
        "icons/*",
        "assets/*"
      ],
      "matches": [
        "https://*.bloomberg.com/*",
        "https://*.wsj.com/*",
        "https://*.nytimes.com/*",
        "https://*.nyt.com/*",
        "https://*.ft.com/*",
        "https://*.economist.com/*"
      ]
    }
  ]
}

{
  "manifest_version": 3,
  "name": "NewsForge - 新闻阅读与翻译",
  "version": "26.3.31",
  "description": "新闻站点干净阅读、AI翻译、图片/PDF分享。支持 Bloomberg、WSJ、NYTimes、FT、The Economist。",
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "styles/content.css",
        "styles/reader.css"
      ],
      "js": [
        "adapters/base.js",
        "adapters/bloomberg.js",
        "adapters/wsj.js",
        "adapters/nytimes.js",
        "adapters/ft.js",
        "adapters/economist.js",
        "reader/renderer.js",
        "reader/translator.js",
        "lib/translator.js",
        "lib/dom-parser.js",
        "lib/html2canvas.min.js",
        "lib/jspdf.umd.min.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "styles/*",
        "icons/*",
        "assets/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
